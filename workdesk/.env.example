# ─────────────────────────────────────────────────────────────────────────────
# WorkDesk Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/workdesk"

# iron-session encryption secret — MUST be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-this-with-a-32-char-minimum-random-secret-string"

# Admin seed credentials (used only during `npm run seed`)
SEED_ADMIN_EMAIL="admin@flexstudios.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"
SEED_ADMIN_NAME="Administrator"

# Cloudflare R2 (S3-compatible object storage for archive file versions)
# Leave placeholder values while using local-fs storage below.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="workdesk"

# ── Local filesystem storage (dev only) ──────────────────────────────────────
# Set to "true" to store files under uploads/ instead of R2.
# Remove (or set to anything else) when switching back to real R2 credentials.
# Also remove src/app/api/storage/local/ when done.
USE_LOCAL_STORAGE="true"

# Base URL for local storage download/upload URLs (no trailing slash).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"
